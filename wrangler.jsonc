
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abyssal-redo-server",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
